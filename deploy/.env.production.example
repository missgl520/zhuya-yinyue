# 竹笌后端 · 生产环境变量模板
# 复制为仓库根目录的 .env 并填写（deploy/deploy.sh 会读取 ../.env）：
#   cp deploy/.env.production.example .env
#
# 【必填】项必须填写，否则存在安全或功能隐患。

# ── 接口签名鉴权（必填）──
# 与前端生产构建的 --dart-define=ZHUYU_API_KEY 必须完全一致，否则所有请求 401。
# 生成：openssl rand -hex 32
ZHUYU_API_KEY=__CHANGE_ME_TO_STRONG_RANDOM__

# ── CORS（建议填写）──
# 移动端 App（WebView 外发请求）一般不受 CORS 限制；Web/调试需要。
# 多个源用逗号分隔，例如：https://app.example.com,https://example.com
# 留空则仅放行内置本地来源（不使用通配符 "*"）。
ALLOWED_ORIGINS=

# ── 静态加密密钥（必填）──
# 记忆/好感度落盘加密。base64 编码的 32 字节 Fernet key。
# 生成：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 一旦设置并写入数据，切勿更改，否则旧数据无法解密。
ZHUYU_ENC_KEY=

# ── 运营主体与联系信息（上线前必填）──
# 用于隐私政策 / 用户协议占位替换；留占位值前端会显示「请填写…」提示。
OPERATOR_NAME=你的运营主体名称
PRIVACY_CONTACT_EMAIL=privacy@example.com
SERVICE_CONTACT_EMAIL=support@example.com

# ── 服务端口（容器内固定 8000，由 nginx 对外暴露）──
PORT=8000

# ── Agnes 大模型对话（可选）──
# 留空 = Mock 演示模式（角色化兜底回复，App 仍可完整对话）。
# 填上 = 真实大模型流式对话（需国内版 apihub.agnes-ai.cn 的 key）。
AGNES_API_KEY=
AGNES_USE_CN=true
AGNES_MODEL=agnes-2.0-flash

# ── LiveKit 语音通话（可选）──
# 留空 = /livekit/connect 返回 available:false。
# 填腾讯云/自建 LiveKit 的 URL 与密钥 = 真实语音房令牌。
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ── 角色 / 唤醒词默认值 ──
PERSONA_DEFAULT=gentle
WAKE_WORD_DEFAULT=竹笌竹笌

# 签名时间容差（秒），防重放
SIGNATURE_TOLERANCE_SECONDS=300

# ── 数据库（可选）──
# 留空 = 本地 SQLite（data/zhuyu.db，随容器 volume 持久化）。
# 生产高并发建议用腾讯云 TencentDB for MySQL，填 SQLAlchemy URL：
#   DATABASE_URL=mysql+pymysql://user:pass@host:3306/zhuyu
