# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 竹笌后端环境变量示例（复制为 .env 后填写）
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# 【必填】Agnes API Key。留空则后端进入「mock 演示模式」，App 仍可完整对话。
# 获取地址参考前端代码：https://apihub.agnes-ai.cn（国内版）
AGNES_API_KEY=
# 是否使用 Agnes 国内版（true/false）
AGNES_USE_CN=true
# 模型名（一般无需改）
AGNES_MODEL=agnes-2.0-flash

# 服务监听端口
PORT=8000

# 【可选】LiveKit 语音通话。不填则 /livekit/connect 返回 available:false
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# 默认情感角色（gentle/playful/wise）
PERSONA_DEFAULT=gentle
# 默认唤醒词
WAKE_WORD_DEFAULT=竹笌竹笌
