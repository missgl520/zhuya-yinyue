# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 竹笌前端环境变量示例（CI / 打包 / 本地联调）
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#
# ⚠️ 前端不读 .env 文件！这些变量通过 Flutter 构建参数注入：
#     flutter run --dart-define=ZHUYU_API_KEY=xxx --dart-define=BACKEND_URL=http://localhost:8000
#
# 对应后端 branches/houduan/.env 中的 ZHUYU_API_KEY（必须一致），
# 否则请求签名校验会失败。

# 后端 API Key（与后端 ZHUYU_API_KEY 一致）
ZHUYU_API_KEY=zhuyu-dev-key-change-me

# 后端地址（本地联调默认）
BACKEND_URL=http://localhost:8000
