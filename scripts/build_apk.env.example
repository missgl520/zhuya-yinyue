# =====================================================================
# 竹笌 (zhuyapp) 构建脚本 / CI 环境变量说明
# ---------------------------------------------------------------------
# 复制本文件为 .env 或按需导出；CI 中请使用对应的 Secrets（不要明文提交）。
# 本地开发时，签名信息来自 android/key.properties + android/app/upload-keystore.jks，
# 下面的 KEYSTORE_* 变量在本地可留空。
# =====================================================================

# ---------- 构建行为（可选）----------
# BUILD_FLAVOR=prod            # Flutter 构建风味，留空=默认
# SPLIT_PER_ABI=1              # 1=按 ABI 拆分(arm64-v8a/armeabi-v7a/x86_64)，留空=单个通用包
# OBFUSCATE=1                  # 1=开启 Dart 混淆（生成 build/debug-info 符号表）
# MINIFY=1                     # 1=开启 R8 压缩/混淆（-PzhuyappMinify=true）
# STRICT_SIGNING=1             # 1=强制 release 签名，缺失即报错
# OUTPUT_DIR=build/release     # 产物输出目录

# ---------- 签名（仅 CI / 命令行需要；本地用 key.properties）----------
# CI：把本地 keystore 转 base64 后作为 secret 注入
#   base64 -w0 android/app/upload-keystore.jks
# KEYSTORE_BASE64=****         # base64 编码的 keystore（CI secret）
# KEYSTORE_FILE=android/app/upload-keystore.jks   # 解码目标路径（一般无需改）
# KEYSTORE_PASSWORD=****       # keystore 密码（CI secret）
# KEY_ALIAS=upload             # 密钥别名
# KEY_PASSWORD=****            # 密钥密码（CI secret）

# ---------- JDK（一般无需设置，脚本会自动探测）----------
# JAVA_HOME=/f/Android/SDK/jbr

# ---------- dart-define（密钥/后端地址，构建时注入，切勿明文提交）----------
# 说明：这些值经 --dart-define 在编译期打入 APK，不会进入源码仓库。
#       生产打包时通过 CI Secret / 本地导出注入；缺失则 App 走硬编码默认值。
# 云端后端地址（CloudBase 云托管服务域名，末尾建议带 /）
# ZHUYU_API_BASE_URL=https://zhuyu-backend-xxxxxxxx.sh.run.tcloudbase.com/
# 后端签名密钥（与云端 EnvParams 中的 ZHUYU_API_KEY 保持一致）
# ZHUYU_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# MiniMax 语音合成密钥（platform.minimax.io 的 API Key，sk-api- 开头）
# 注：MiniMax 账户需有足够余额，否则 TTS 返回 1008（insufficient balance）
# MINIMAX_API_KEY=sk-api-xxxxxxxx
